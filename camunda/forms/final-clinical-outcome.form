      "id": "Field_fco001"
    },
    {
      "label": "Final Clinical Outcome Summary",
      "type": "textarea",
      "layout": {
        "row": "Row_fco002",
        "columns": null
      },
      "id": "Field_fco002",
      "key": "finalClinicalOutcomeSummary",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Final Outcome Type",
      "type": "radio",
      "layout": {
        "row": "Row_fco003",
        "columns": null
      },
      "id": "Field_fco003",
      "key": "finalOutcomeType",
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "Discharge back to GP",
          "value": "discharge"
        },
        {
          "label": "Follow-up Consultation",
          "value": "followUp"
        },
        {
          "label": "Treatment Appointment",
          "value": "treatment"
        }
      ]
    },
    {
      "label": "Clinical Advice",
      "type": "textarea",
      "layout": {
        "row": "Row_fco004",
        "columns": null
      },
      "id": "Field_fco004",
      "key": "clinicalPlan",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Follow-up Requirements",
      "type": "textarea",
      "layout": {
        "row": "Row_fco005",
        "columns": null
      },
      "id": "Field_fco005",
      "key": "followUpRequirements",
      "conditional": {
        "hide": "= finalOutcomeType != \"followUp\""
      }
    },
    {
      "label": "Treatment Plan",
      "type": "textarea",
      "layout": {
        "row": "Row_fco006",
        "columns": null
      },
      "id": "Field_fco006",
      "key": "treatmentPlan",
      "conditional": {
        "hide": "= finalOutcomeType != \"treatment\""
      }
    },
    {
      "label": "Discharge Advice to GP",
      "type": "textarea",
      "layout": {
        "row": "Row_fco007",
        "columns": null
      },
      "id": "Field_fco007",
      "key": "dischargeAdvice",
      "conditional": {
        "hide": "= finalOutcomeType != \"discharge\""
      }
    }
  ],
